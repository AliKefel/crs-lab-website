---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lab } from '../data/lab';
import { researchThrusts } from '../data/researchThrusts';
import { sponsors } from '../data/sponsors';
import { getCollection } from 'astro:content';

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title={lab.shortName} description={lab.mission}>
  <section class="wrap grid grid-cols-1 items-center gap-8 py-14 pb-10 md:grid-cols-[1.2fr_1fr] md:gap-12">
    <div>
      <span class="eyebrow">{lab.director}, {lab.directorTitle}</span>
      <h1>{lab.name}</h1>
      <p class="text-text max-w-[62ch] text-lg">{lab.mission}</p>
      <div class="mt-2 flex flex-wrap gap-6">
        <a href="/research" class="font-sans text-sm font-medium no-underline">Research areas &rarr;</a>
        <a href="/publications" class="font-sans text-sm font-medium no-underline">Publications &rarr;</a>
        <a href="/people" class="font-sans text-sm font-medium no-underline">People &rarr;</a>
      </div>
    </div>
    <figure class="m-0">
      <img src={lab.heroImage} alt={lab.heroImageAlt} class="aspect-4/3 w-full object-cover" />
      <figcaption>{lab.heroImageCaption}</figcaption>
    </figure>
  </section>

  <section class="border-rule border-t">
    <div class="wrap py-8">
      <span class="eyebrow">Research support from the following funding agencies is gratefully acknowledged:</span>
      <ul class="mt-4 flex flex-wrap items-center gap-x-10 gap-y-5 list-none p-0">
        {
          sponsors.map((sponsor) => (
            <li>
              <a
                href={sponsor.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={sponsor.name}
                class="block"
              >
                <img
                  src={sponsor.logo}
                  alt={sponsor.name}
                  class="h-11 md:h-16 w-auto"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-rule border-t">
    <div class="wrap py-12">
      <span class="eyebrow">Research</span>
      <h2>Four active thrusts</h2>
      <ul class="mt-6 list-none p-0">
        {
          researchThrusts.map((thrust) => (
            <li class="border-rule-soft grid grid-cols-1 gap-2 border-t py-5.5 first:border-t-0 md:grid-cols-[72px_1fr] md:gap-5">
              <span class="font-serif text-maroon text-[2rem] leading-none">{thrust.number}</span>
              <div>
                <h3 class="mb-1.5">
                  <a href={`/research/${thrust.slug}`} class="text-ink hover:text-maroon no-underline">
                    {thrust.title}
                  </a>
                </h3>
                <p class="text-text m-0">{thrust.summary}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="border-rule border-t">
        <div class="wrap py-12">
          <span class="eyebrow">Latest news</span>
          <h2>Recent updates</h2>
          <ul class="mt-6 mb-7 list-none p-0">
            {news.map((post) => (
              <li class="border-rule-soft border-t py-4.5 first:border-t-0">
                <p class="meta">
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </p>
                <h3 class="my-1.5">
                  <a href={`/news/${post.slug}`} class="text-ink hover:text-maroon no-underline">
                    {post.data.title}
                  </a>
                </h3>
                <p class="m-0">{post.data.summary}</p>
              </li>
            ))}
          </ul>
          <a href="/news" class="font-sans text-sm font-medium no-underline">
            All news &rarr;
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
